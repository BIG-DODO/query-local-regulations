.40"],[null,null,"改建","≥70%","≥45%","≤0.50"],["U","市政设\n施用地","新建","≥65%","≥45%","≤0.55"],[null,null,"改建","≥50%","≥40%","≤0.80"]]},{"page":35,"rows":[["序\n号","低影响\n开发模\n式","概念解释","对应LID系列技术举\n例"],["1","雨水径\n流污染\n控制模\n式","以水质净化为主要目标。通过\n物理或生物措施对初期雨水\n污染物进行截、滤和净化，从\n而达到水质净化的目标。","植被浅沟、雨水花\n园、卵石渠、雨水塘、\n雨水湿地、生态树\n池、下凹式绿地等。"]]},{"page":36,"rows":[["序\n号","低影响\n开发模\n式","概念解释","对应LID系列技术举\n例"],["2","雨水渗\n透减排\n模式","以雨水渗透为主要目标。通过\n路面铺装、排水管渠等材料的\n改变，增强雨水入渗能力、削\n减雨水径流量，补充地下水。","透水路面、渗透管\n渠、渗透井（池）等。"],["3","峰值调\n控模式","以削减洪峰流量为主要目标。\n通过设置流量调控设施，在降\n雨径流高峰时暂时蓄存雨水，\n延长径流雨水排入河道的时\n间，减少内涝和积水。","雨水塘、雨水湿地、\n人工湖、调蓄池等"],["4","雨水利\n用模式","以雨水利用、削减雨水外排量\n为主要目标。通过对不同下垫\n面的雨水进行收集、储存、净\n化，将雨水转化为满足一定水\n质标准的回用水（可用于浇\n灌、路面冲洗、汽车冲洗、消\n防用水及景观补充水）。","雨水收集管网、储存\n池、处理设施和回用\n水管网等。"]]}],"jiaxing-2018-063":[{"page":37,"rows":[["道路\n等级","机动车\n设计速度\n（公里/小\n时）","红线宽度L\n（米）","机动车\n道数\n（条）","交叉口最\n小视距\n（米）","道路网密度\n（公里/平\n方公里）"],["快速路","60～100","L≥42","4～6","75","0.3～0.4"],["主干路","40～60","40≤L＜60","4～6","60","0.8～1.2"],["次干路","30～50","20≤L＜40","2～4","40","1.2～1.4"],["支路","20～40","13≤L＜20","2","25","3.0～4.0"]]}],"jiaxing-2018-064":[{"page":37,"rows":[["道路\n等级","机动车\n设计速度\n（公里/小\n时）","红线宽度L\n（米）","机动车\n道数\n（条）","交叉口最\n小视距\n（米）","道路网密度\n（公里/平\n方公里）"],["快速路","60～100","L≥42","4～6","75","0.3～0.4"],["主干路","40～60","40≤L＜60","4～6","60","0.8～1.2"],["次干路","30～50","20≤L＜40","2～4","40","1.2～1.4"],["支路","20～40","13≤L＜20","2","25","3.0～4.0"]]}],"jiaxing-2018-076":[{"page":43,"rows":[["建筑类型",null,null,"计算单位","机动车",null,"非机\n动车"],[null,null,null,null,"旧城区","新区\nU U",null],["住宅","独立式住宅",null,"车位/100平方米\n建筑面积","0.8","1.2，且满\n足1车/户","--"],[null,"商品房、拆迁安置房",null,null,null,null,"2.0"],[null,"经济适用房、廉租房",null,null,"0.4","0.5","2.0"],[null,"注：乡镇可适当降低配建标准，但不得低于1.0车位/100平方米建筑面积，且满足\n1车位/户。",null,null,null,null,null],["办公","行政\n办公","具有对外窗口服\n务功能","车位/100平方米\n建筑面积","1.5","2.0","3.0"],[null,null,"其他行政办公",null,"1.0","1.2","2.0"],[null,"其他办公",null,null,"0.8","1","2.0"],["商业","建筑面积＞10000平方米",null,"车位/100平方米\n建筑面积","0.8","1","6.0"],[null,"建筑面积≤